{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "CommonJS", "moduleResolution": "Node",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "rootDir": "..", "noEmit": true, "types": ["node"], "noUncheckedIndexedAccess": true
  },
  "include": ["./**/*.ts"]
}
