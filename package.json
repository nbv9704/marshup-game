{
  "name": "mashup-arena",
  "private": true,
  "version": "0.1.0",
  "description": "Offline Windows desktop arcade shell and deterministic practice game",
  "author": "Mashup Arena",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "test": "vitest run && npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "dist": "npm test && npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:core-offline": "node scripts/test-core-offline.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.7",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "concurrently": "9.2.0",
    "cross-env": "7.0.3",
    "electron": "36.4.0",
    "electron-builder": "26.0.12",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4",
    "wait-on": "8.0.3",
    "@fontsource/inter": "5.2.5",
    "@fontsource/space-grotesk": "5.2.5",
    "pixi.js": "8.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "build": {
    "appId": "games.mashuparena.desktop",
    "productName": "Mashup Arena",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/default-save.json",
      "build/icon.png",
      "electron/splash.html",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "MashupArena-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "MashupArena-${version}-portable.${ext}"
    }
  },
  "dependencies": {}
}
